<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300 nav-transparent">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <div></div>

    <!-- Links -->
    <div class="flex items-center gap-6 text-sm">
      <a href="#servicios" class="nav-link transition-colors duration-200 hidden sm:block">Servicios</a>
      <a href="#nosotros" class="nav-link transition-colors duration-200 hidden sm:block">Nosotros</a>
      <a
        href="#contacto"
        class="px-4 py-2 bg-white/20 text-white text-sm rounded-md hover:bg-white hover:text-text transition-all duration-200 nav-cta"
      >
        Consultar
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  if (nav) {
    // Solo toca las clases al cruzar los 80 px: hacerlo en cada evento de scroll recalcula estilos sin necesidad.
    let solida: boolean | null = null;
    const handleScroll = () => {
      const ahora = window.scrollY > 80;
      if (ahora === solida) return;
      solida = ahora;
      nav.classList.toggle('nav-solid', ahora);
      nav.classList.toggle('nav-transparent', !ahora);
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }
</script>
