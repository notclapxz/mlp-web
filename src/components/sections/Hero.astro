---
---

<section id="inicio" class="hero-section relative min-h-screen flex items-start justify-center pt-16 overflow-hidden" style="background-color: #1A1A2E">
  <!-- Imagen de fondo — fallback oscuro si no carga -->
  <img
    src="/oficina-reuniones.png"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    loading="eager"
    class="absolute inset-0 w-full h-full object-cover"
    style="z-index:0"
  />
  

  <!-- Overlay oscuro -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70" style="z-index:1"></div>

  <!-- Contenido -->
  <div class="relative w-full max-w-5xl mx-auto px-6 text-center flex flex-col min-h-[calc(100vh-4rem)]" style="z-index:2">

    <!-- Texto centrado verticalmente -->
    <div class="flex-1 flex flex-col items-center justify-center">
      <h1 class="reveal reveal-delay-1 text-3xl sm:text-4xl lg:text-5xl font-semibold text-white leading-tight mb-3">
        Risco Valera Abogados &amp; Consultores
      </h1>
      <p class="reveal reveal-delay-2 text-base sm:text-lg text-white/75 font-light tracking-wide uppercase">
        Media & Legal Planning Chamber
      </p>
    </div>

    <!-- CTA pegado al fondo -->
    <div class="pb-16 reveal reveal-delay-3 flex flex-col sm:flex-row gap-3 justify-center items-center">
      <a
        href="#contacto"
        class="px-8 py-3.5 bg-white text-text rounded-md hover:bg-white/90 transition-colors duration-200 text-sm font-medium"
      >
        Solicitar consulta
      </a>
      <a
        href="#servicios"
        class="px-8 py-3.5 text-white border border-white/40 rounded-md hover:border-white hover:bg-white/10 transition-colors duration-200 text-sm font-medium"
      >
        Ver servicios
      </a>
    </div>


  </div>
</section>
