---
const credenciales = [
  { titulo: 'Título de Abogado',              inst: 'PUCP',                            year: '1997', color: '#E8B84B' },
  { titulo: 'Maestría en Ciencias Penales',   inst: 'UNMSM',                           year: '2006', color: '#3A7D44' },
  { titulo: 'Máster en Política Criminal',    inst: 'Univ. de Salamanca',              year: '2025', color: '#2B6CB0' },
  { titulo: 'Compliance Corporativo',         inst: 'Instituto para la Calidad — PUCP', year: '2021', color: '#E8B84B' },
  { titulo: 'Master en Gerencia Pública',     inst: 'EUCIM Business School',           year: '2018', color: '#3A7D44' },
  { titulo: 'Máster en Alta Dirección Empresarial', inst: 'European Open Business School', year: '2021', color: '#2B6CB0' },
];
---

<section id="nosotros" class="py-20 lg:py-28 bg-cream">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="reveal text-center mb-14">
      <p class="text-xs font-medium tracking-widest text-text-muted uppercase mb-3">El estudio</p>
      <h2 class="text-3xl sm:text-4xl font-light text-text">
        Trayectoria y <span class="font-medium">formación</span>
      </h2>
    </div>

    <!-- Foto panorámica -->
    <div class="reveal mb-14 overflow-hidden rounded-xl shadow-lg">
      <img
        src="/hero-oficina.jpeg"
        srcset="/img/sala-800.jpg 800w, /hero-oficina.jpeg 1377w"
        sizes="(min-width: 1152px) 1104px, 100vw"
        width="1377"
        height="768"
        alt="Estudio de abogados — sala de trabajo"
        class="w-full h-64 sm:h-80 lg:h-96 object-cover hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>

    <!-- Grid: columna izquierda con sticky para acompañar el scroll de la columna derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">

      <!-- Foto — columna izquierda (2/5) -->
      <div class="reveal lg:col-span-2 flex flex-col items-center lg:items-start gap-6">
        <!-- Foto circular con ring de acento -->
        <div class="relative">
          <div class="w-48 h-48 lg:w-52 lg:h-52 rounded-full ring-4 ring-blue/15 ring-offset-4 ring-offset-cream overflow-hidden shadow-lg">
            <img
              src="/dr-rolando.jpg"
              width="176"
              height="176"
              alt="Rolando Zagret Risco Valera — Fundador y Socio principal"
              loading="lazy"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <!-- Badge CAL -->
          <div class="absolute -bottom-2 -right-2 bg-blue text-white text-[10px] font-semibold px-2.5 py-1 rounded-full shadow-md">
            CAL N° 35124
          </div>
        </div>

        <!-- Identidad debajo de la foto -->
        <div class="text-center lg:text-left">
          <p class="font-semibold text-text text-base leading-tight">Rolando Zagret<br/>Risco Valera</p>
          <p class="text-sm text-text-muted mt-1.5">Fundador y Socio principal · San Isidro, Lima</p>
        </div>

      </div>

      <!-- Contenido derecho — columna derecha (3/5) -->
      <div class="lg:col-span-3">

        <p class="reveal text-text-muted leading-relaxed mb-8 text-sm">
          Risco Valera Abogados &amp; Consultores es un estudio jurídico con sede en San Isidro, Lima. Con más de 20 años de ejercicio profesional y más de 15 años bajo la marca MLP, brindamos asesoría legal a personas naturales y empresas con un enfoque directo y orientado a resultados.
        </p>

        <!-- Formación + Stats lado a lado -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 items-start">

          <!-- Formación académica (2/3) -->
          <div class="reveal reveal-delay-1 sm:col-span-2">
            <p class="text-xs font-medium tracking-widest text-text-muted uppercase mb-4">Formación académica</p>
            <ul class="flex flex-col gap-3">
              {credenciales.map((cred) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-none" style={`background:${cred.color}`}></span>
                  <div>
                    <p class="text-sm font-medium text-text leading-tight">{cred.titulo}</p>
                    <p class="text-xs text-text-muted mt-0.5">{cred.inst} · {cred.year}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Stats (1/3) -->
          <div class="reveal reveal-delay-2 sm:col-span-1 flex flex-col gap-6 sm:border-l border-text/10 items-center text-center sm:pl-6 justify-center h-full">
            <div>
              <p class="text-2xl font-light text-text">20+</p>
              <p class="text-xs text-text-muted uppercase tracking-wide mt-1">Años de ejercicio</p>
            </div>
            <div>
              <p class="text-2xl font-light text-gold">15+</p>
              <p class="text-xs text-text-muted uppercase tracking-wide mt-1">Años de MLP</p>
            </div>
            <div>
              <p class="text-2xl font-light text-stat-green">4</p>
              <p class="text-xs text-text-muted uppercase tracking-wide mt-1">Maestrías y posgrados</p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

